# ---- LLM Provider ----
# openai | anthropic | mock   （mock = 离线确定性模型，无需任何 Key）
CODEASSISTANT_PROVIDER=mock

# openai 兼容模式下的模型名与地址（DeepSeek / Kimi / Qwen / OpenAI 均可）
CODEASSISTANT_MODEL=gpt-4o-mini
CODEASSISTANT_BASE_URL=
CODEASSISTANT_API_KEY=
CODEASSISTANT_TEMPERATURE=0.0

# Anthropic 模式
# CODEASSISTANT_MODEL=claude-sonnet-4-5
# CODEASSISTANT_API_KEY=sk-ant-...

# ---- 工作区 ----
# 代码助手可读写的根目录，所有工具路径都被限制在此之下
CODEASSISTANT_WORKSPACE=.

# ---- 专家包 ----
CODEASSISTANT_EXPERTS_DIR=./.codeassistant/my-experts

# ---- 状态持久化 ----
# memory | sqlite
CODEASSISTANT_CHECKPOINTER=sqlite
CODEASSISTANT_STATE_DB=.codeassistant/state.db

# ---- 协作参数 ----
# dynamic（逐次调用审批） | static（整批执行前统一放行）
CODEASSISTANT_APPROVAL_MODE=dynamic
CODEASSISTANT_MAX_TEAM_ROUNDS=8
# 专家团默认协作模式：supervisor（主理人调度） | parallel（并行汇）
CODEASSISTANT_DEFAULT_TEAM_MODE=supervisor
